# Script writing + fact check (https://console.anthropic.com)
WH_ANTHROPIC_API_KEY=
# Voices (https://elevenlabs.io) — Creator plan or higher for Text-to-Dialogue
ELEVENLABS_API_KEY=
# Optional voice overrides; leave blank to use the defaults (Eric = advisor, Jessica = traveler)
ELEVENLABS_VOICE_ADVISOR=
ELEVENLABS_VOICE_TRAVELER=
# Optional: pronunciation dictionary created in ElevenLabs
ELEVENLABS_PRONUNCIATION_DICT_ID=
# Gemini TTS comparison (https://aistudio.google.com)
GEMINI_API_KEY=
# WhataHotel data API (same key as Price Intelligence's WAH_API_KEY)
WAH_API_KEY=
# Price Intelligence Neon database — use a READ-ONLY role
PI_DATABASE_URL=
# Firecrawl (https://firecrawl.dev) — scrape pages a plain fetch cannot get
FIRECRAWL_API_KEY=
# Vercel Blob read-write token — `publish` uploads approved audio here
BLOB_READ_WRITE_TOKEN=
