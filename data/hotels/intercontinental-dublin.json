        "s5"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel is near Sandymount, Herbert Park and Trinity College.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-4",
      "text": "The hotel was formerly the Four Seasons.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-5",
      "text": "The lobby features a chandelier.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Rooms and suites have marble bathrooms with deep-soaking tubs.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "Rooms have Nespresso coffee machines and Byredo bath amenities.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-8",
      "text": "Selected rooms have private balconies, and interconnecting options are available for families and groups.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-9",
      "text": "Suites include the W.B. Yeats Suite, the Lady Gregory Suite and the James Joyce Suite.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-10",
      "text": "The spa has a heated pool, steam room and sauna.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-11",
      "text": "Simmons Restaurant overlooks the hotel's gardens and serves contemporary Irish cuisine rooted in seasonality and provenance.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-12",
      "text": "The Reading Room is filled with Irish art, overlooks the private Garden Terrace and serves traditional or Champagne Afternoon Tea.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The spa offers ESPA treatments in a naturally lit space with an outdoor garden.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The Lobby Lounge looks onto the inner courtyard garden through Victorian-style conservatory windows.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-3",
      "text": "The indoor heated pool area is bathed in natural light and has a jacuzzi.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "The Whiskey Bar has a collection of over 100 whiskeys, including 69 Irish labels, with a selection tailored by the hotel's Whiskey Sommelier.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The hotel is in Ballsbridge rather than the city centre; Trinity College is 12 minutes from the hotel.",
      "source_ids": [
