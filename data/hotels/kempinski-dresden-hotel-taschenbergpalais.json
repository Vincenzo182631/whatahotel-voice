  "name": "Kempinski Dresden - Hotel Taschenbergpalais",
  "location": {
    "city": "Dresden",
    "country": "Germany"
  },
  "category": "urban",
  "positioning": "Hotel Taschenbergpalais Kempinski Dresden, in the Innere Altstadt, a few steps from the Semper Opera House, Royal Palace and Zwinger",
  "best_for": [
    "Travelers who want to walk to Dresden's opera house, palaces and museums",
    "Guests travelling with a dog"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Located directly in Dresden's historic city centre, the Innere Altstadt, a few steps from sights such as the Semper Opera House, Royal Palace, Zwinger and Frauenkirche.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Pre-theatre dinner can be had at Das Palais or Kastenmeiers.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-3",
      "text": "Dresden International Airport is about 10.7 km from the hotel, around 20 to 30 minutes by car depending on traffic.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "The closest public transport stop is Postplatz, served by several tram lines and two bus lines.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "From the city centre, the banks of the Elbe can be reached in just a few minutes.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Les Clefs d'Or concierges can assist with ticket reservations, private tours and recommendations.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "The hotel has one charging station for Tesla vehicles and two for electric cars.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "Moritzburg Castle is about a 20-minute drive from the hotel.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "August the Great built the Taschenberg Palace for his mistress, Anna Constantia.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-2",
      "text": "The MICHELIN Guide 2025 awarded the hotel two MICHELIN Keys.",
      "source_ids": [
        "s3"
      ],
      "expires": "2026-12-31"
    },
    {
      "id": "h-3",
      "text": "The Semperoper is a two-minute stroll (200 metres) from the hotel across Theaterplatz.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "The concierge can arrange out-of-hours tours of the Green Vault as part of the GHA Experience.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-5",
      "text": "Dogs receive a dog bed, blanket, feeding bowl and snacks, and there is an à la Carte Dog Menu.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Dresden levies an accommodation tax of 6% of the gross accommodation cost, which is already included in the hotel's quoted rates.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel welcomes dogs exclusively; other pets cannot be accommodated.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes premium luxury pricing reflecting the palace heritage.",
      "source_ids": [
