    "Groups wanting a private villa within the hotel's park"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel's address is Via Regina 40 in Cernobbio, Italy.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Services include private boat transfers, a boutique, a concierge and a helipad.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Classic Rooms overlook the inner courtyard of the historic Cardinal's residence.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-4",
      "text": "Deluxe Rooms are in the Cardinal's Building or the Queen's Pavilion and have a front-facing view of Lake Como.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "Deluxe Superior Rooms are on the upper floors of the Cardinal's Building, with views of the lake.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-7",
      "text": "Junior Suite Exclusive rooms combine yellow, red and blue with period furnishings.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-8",
      "text": "The Presidential Suites are on the first floor of the Cardinal Building.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-9",
      "text": "Rooms come with a complimentary minibar.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "Room service can be served in the guest's room or on the balcony.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Cardinal Suite, on the first floor of the Cardinal Building, pays homage to Tolomeo Gallio, the visionary behind the villa.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "Four secluded villas sit in the heart of the hotel's centuries-old park.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-3",
      "text": "The Cardinal Suite has a generous terrace overlooking the lake.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-4",
      "text": "The Executive Suite has two private balconies, one in the bedroom and one in the living room, opening onto the gardens.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Not every room faces the lake: Classic Rooms look onto the inner courtyard and Executive Rooms have garden views.",
      "source_ids": [
        "s5",
        "s10"
      ]
    },
    {
      "id": "c-2",
      "text": "For families, Classic Rooms can be interconnected, and Junior Suite Exclusive rooms can be connected to an Executive Double Room.",
      "source_ids": [
        "s5",
        "s9"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes ultra-luxury pricing and formal dress codes in the main dining areas.",
      "source_ids": [
        "s1"
      ]
    }
  ],
