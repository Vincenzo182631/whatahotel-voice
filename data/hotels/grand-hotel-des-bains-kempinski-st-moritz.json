        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Crazy Pizza St. Moritz is an informal Italian restaurant at the hotel with no dress code.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "The hotel offers 24-hour room service.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Guests can choose from a pillow menu, and alternative or additional pillows are included in the room rate.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-6",
      "text": "The hotel has an alpine-style spa.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-7",
      "text": "The hotel offers complimentary amenities for young guests, such as a high chair and a baby bottle warmer.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "The hotel has a Kids Club with family-friendly activities and facilities.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel welcomes both dogs and cats.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Neora is a modern Greek restaurant at the hotel, described by the hotel as the first modern Greek restaurant in Engadine.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "In winter, horse-drawn carriage rides to the mountain lake Lej da Staz depart directly from the hotel entrance.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-3",
      "text": "A cable car is right next door to the hotel.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-4",
      "text": "The summer activity programme includes a guided hike with Chef Jonas Starkowski that ends in a gourmet picnic.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "considerations": [
