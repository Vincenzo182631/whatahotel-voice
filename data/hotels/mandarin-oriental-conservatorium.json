        "s7"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel began as a bank and soon after a music school.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The building was first the national savings bank and later a music conservatory.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-4",
      "text": "Italian architect Piero Lissoni worked on the renovation of the building.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "The light-filled lobby is the former courtyard, now with a glass atrium.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-6",
      "text": "The Lounge sits beneath the hotel's iconic glass ceiling.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-7",
      "text": "Ottolenghi Amsterdam is the chef's first restaurant in the Netherlands.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-8",
      "text": "Ottolenghi Amsterdam serves a Mediterranean, vegetable-led menu in the glass atrium.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "The Stedelijk Museum Amsterdam is just across the street from the hotel.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-10",
      "text": "Vondelpark is a short stroll from the hotel.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The Royal Concertgebouw concert hall is across the street and down the road.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-12",
      "text": "Akasha has a Watsu pool.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
