  "whatahotel_url": "https://www.whatahotel.com/hotels/1055/villa-la-massa.html",
  "name": "Villa La Massa",
  "location": {
    "city": "Florence",
    "country": "Italy"
  },
  "category": "other",
  "positioning": "Riverside estate of six buildings on the Arno at Candeli, just outside Florence, with Renaissance-style rooms and suites",
  "best_for": [
    "Travelers who want a quiet riverside base near Florence",
    "Families or friends wanting two-bedroom suites"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Villa La Massa is at Via della Massa 24 in Candeli, near Florence.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The rooms are spread across the estate's six buildings.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The suites look out over the Arno and the Chianti hills, just moments from the heart of Florence.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Prestige Rooms in Villa Nobile and Il Mulino have wood panelling, canopy beds, linen wall coverings and either frescoed ceilings or exposed beams.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "The Presidential Suite has two bedrooms, a lounge with a fireplace and a private riverside terrace.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "The Parco Suite has two bedrooms, two marble bathrooms and a living room.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-7",
      "text": "Il Verrocchio serves Italian and Tuscan traditional cuisine made with local ingredients.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "Meals can be taken on a terrace overlooking the River Arno, by the pool or in a frescoed salon.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-9",
      "text": "Culinary experiences include a cocktail class, wine tastings and a cooking class.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-10",
      "text": "The executive chef is Stefano Ballarino.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-11",
      "text": "Villa La Massa also offers villas and apartments.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Suite Colonica suites are in the 19th-century Casa Colonica farmhouse, with Santafiora stone, terracotta and jasmine-scented courtyards.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "Junior Suites Top in Villa Nobile, Il Villino and Il Mulino use 16th-century damask and fabrics made by artisans of nearby Rovezzano.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-3",
      "text": "L'Oliveto is a poolside bistro in a former stone hay barn.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-4",
      "text": "The Arno Suite in Il Villino has a private garden, a lounge with fireplace and a panoramic terrace above the Arno.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-5",
      "text": "Exclusive Rooms in La Limonaia have private gardens on the ground floor and terraces over the Arno on the upper level.",
      "source_ids": [
        "s10"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The restaurants and bar are open from April to November.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel is in Candeli, outside central Florence, rather than in the historic center.",
      "source_ids": [
        "s2",
        "s3"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes premium luxury pricing and limited on-site parking.",
      "source_ids": [
        "s1"
      ]
    }
  ],
