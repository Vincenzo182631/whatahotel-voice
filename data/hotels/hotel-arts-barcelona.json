  "facts": [
    {
      "id": "f-1",
      "text": "Hotel Arts Barcelona is described as an artistic urban resort where the energy of the city meets the tranquility of the coast.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The property was built for the 1992 Summer Olympics.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "The Arts Wellness spa is located on the 4th floor.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-4",
      "text": "Guest rooms have exclusive headboards by Lorena Canals.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-5",
      "text": "Marina Coastal Food serves Mediterranean coastal cuisine with sea views.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "The fitness center is open 24 hours a day, 7 days a week.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "The Club Lounge offers complimentary food and beverage presentations five times each day.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "Arts Kids is led by Frankie the Whale, a character inspired by the Mediterranean.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-9",
      "text": "The Marina Family Pool is open every day during summer season and is exclusive to hotel guests.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-10",
      "text": "Barcelona-El Prat Airport is 20 km from the hotel.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Arts Suite has a bathroom with a private sauna and a walk-in dressing room.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-2",
      "text": "The Skyline Suites feature views of the Sagrada Família.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-3",
      "text": "The hotel runs Arts Kids, a curated programme for younger guests.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-4",
      "text": "The Family Pool is a space for guests of all ages, surrounded by landscaped gardens and overlooking the Mediterranean.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
