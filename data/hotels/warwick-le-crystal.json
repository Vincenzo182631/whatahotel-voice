      ]
    },
    {
      "id": "f-4",
      "text": "The hotel sits in downtown's Golden Square Mile.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-5",
      "text": "The hotel is about halfway between the Lucien L'Allier and Guy-Concordia Metro stops.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Suites feature bold, modern design, kitchenettes and oversized bathrooms filled with light.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-7",
      "text": "The 12th floor has an indoor saltwater pool and a Swedish sauna.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "The pool is heated all year long.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-9",
      "text": "Siam Downtown, a sister restaurant to Siam Quartier DIX30 in Brossard, serves Thai cuisine steps from the suites.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-10",
      "text": "It is Warwick Hotels and Resorts' first hotel in Canada.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The hotel offers 24-hour valet service with in/out privileges and EV charging stations.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-12",
      "text": "Pets are welcomed with a Warwick Pet Kit.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The wellness centre is on the 12th floor, with an indoor pool, outdoor hot tub, sauna, gym and beauty spa overlooking downtown Montreal.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "Penthouse Suites have large private rooftop terraces with sweeping views.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-3",
      "text": "The Warwick Premier Suite is a corner unit with a fireplace, a high-top lunch counter overlooking Mont-Royal and a private balcony above Rene-Levesque Boulevard.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-4",
      "text": "Children up to 17 years old stay free with their parents.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The spa, Elements Maison de Beaute, is small and offers mostly facials, cosmetic laser treatments, waxing, pedicures and manicures.",
