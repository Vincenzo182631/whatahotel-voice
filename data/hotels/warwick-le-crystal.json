      ]
    },
    {
      "id": "f-2",
      "text": "The hotel is in downtown Montreal, steps from Mont Royal, the Bell Centre and the city's premier shopping.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The Bell Centre is one block from the hotel.",
      "source_ids": [
