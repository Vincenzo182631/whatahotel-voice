{
  "slug": "the-dorchester",
  "whatahotel_id": 1002,
  "whatahotel_url": "https://www.whatahotel.com/hotels/1002/the-dorchester.html",
  "name": "The Dorchester",
  "location": {
    "city": "London",
    "country": "GB"
  },
  "category": "urban",
  "positioning": "Mayfair hotel on Park Lane, directly opposite Hyde Park, refreshed by a four-year renovation completed in 2026",
  "best_for": [
    "Travelers who want a Mayfair base facing Hyde Park",
    "Guests who want afternoon tea, bars and several restaurants under one roof",
    "Families, with complimentary infant cots"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The Dorchester is on Park Lane in Mayfair, overlooking Hyde Park, halfway between Buckingham Palace and Marble Arch.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The Dorchester sits directly opposite Hyde Park, and many rooms and suites have views across the park.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "In 2026 The Dorchester completed a major four-year renovation that refreshed its rooms, suites and public spaces while preserving its historic character.",
      "source_ids": [
        "s2"
      ],
      "expires": "2027-12-31"
    },
    {
      "id": "f-4",
      "text": "The rooms and suites are inspired by the colours and motifs of a classic English garden.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "The Grill at The Dorchester serves modern British cuisine.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "China Tang serves dim sum all day in its bar.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-7",
      "text": "Afternoon tea is served in The Promenade.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "Vesper Bar was designed by London interiors specialist Martin Brudnizki.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-9",
      "text": "The Chef's Table is a private dining space inside the hotel's kitchen, seating up to 12 guests.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-10",
      "text": "The spa includes treatment rooms, a relaxation room, an MLX Quartz treatment bed and the Carol Joy London hair salon.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-11",
      "text": "The spa offers La Prairie facial treatments.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-12",
      "text": "Infant cots are complimentary.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Royal Suite occupies a corner of the eighth floor above Hyde Park.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "In The Promenade, Liberace's piano is played by a resident pianist.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-3",
      "text": "Artists' Bar has a bespoke Lalique crystal bar and mirrored interiors.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-4",
      "text": "China Tang at The Dorchester is a subterranean restaurant.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-5",
      "text": "The hotel's butlers are all trained to a royal standard.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The Dorchester has no pool in the hotel itself; guests can use the indoor pool at sister hotel 45 Park Lane.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel asks guests not to wear shorts or sportswear during afternoon tea and in the evening.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-3",
      "text": "Advance reservations are recommended for the restaurants and afternoon tea.",
      "source_ids": [
        "s5"
      ]
    }
  ],
