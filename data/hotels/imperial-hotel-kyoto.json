  },
  "category": "urban",
  "positioning": "Gion hotel within the grounds of the Gion Kobu Kaburenjo theatre, carrying on the Yasaka Kaikan, a nationally Registered Tangible Cultural Property",
  "best_for": [
    "Travelers who want to stay in the heart of Gion's geiko district",
    "Guests who want historic-building character, including rooms that keep parts of the Yasaka Kaikan or have tatami floors",
    "Visitors timing a spring trip around the Miyako Odori dances"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel stands at the end of Hanamikoji-dori in Gion Kobu.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel carries on the Yasaka Kaikan, a nationally Registered Tangible Cultural Property.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "Imperial Hotel, Kyoto opened on March 5, 2026.",
      "source_ids": [
        "s4"
      ],
      "expires": "2027-09-30"
    },
    {
      "id": "f-4",
      "text": "The Imperial Suite is the hotel's top suite and has a terrace facing the Higashiyama mountains.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-5",
      "text": "The Yasaka Suite's balcony looks out to Kennin-ji temple.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "Main building rooms take in views of Kyoto and Gion and the changing seasons on the Kitayama hills and Mount Hiei.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-7",
      "text": "Before the Miyako Odori performance, guests attend a tea ceremony served by a geiko.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-8",
      "text": "The Gion Hanamachi Art Museum sits on the same Gion Kobu Kaburenjo grounds as the hotel.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel offers a Gosho doll painting experience at the Shimada Koen workshop on Ninenzaka.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-10",
      "text": "The spa uses EU-certified organic essential oils, products from the British brand OSKIA and traditional bells made by Kyoto craftspeople.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The Japanese breakfast is a menu created for hotel guests by the owner of the kappo restaurant Gion Kawakami.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-12",
      "text": "The hotel was awarded one Michelin Key in the Michelin Key Hotel Selection 2026.",
      "source_ids": [
        "s3"
      ],
      "expires": "2027-06-30"
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Imperial Hotel, Kyoto stands within the grounds of the Gion Kobu Kaburenjo theatre.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "Heritage rooms in the main building's preserved area keep parts of the Yasaka Kaikan, such as pillars and window frames.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-3",
      "text": "The hotel arranges tickets to the spring Miyako Odori dance performances for its overnight guests.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "North wing rooms are Japanese-modern rooms with tatami floors.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-5",
      "text": "The spa has an indoor pool, a heat experience zone, and twin and single treatment rooms.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Parking for hotel guests is limited to 4 spaces.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "The fitness gym is not staffed.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes premium pricing that reflects the hotel's luxury positioning.",
