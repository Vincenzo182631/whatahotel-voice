        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Carlisle Bay is a member of Leading Hotels of the World.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-3",
      "text": "Suites offer views of the ocean or tropical gardens through floor-to-ceiling windows.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Suites include a day bed on the balcony or terrace.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Complimentary afternoon tea is among the suite features.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-6",
      "text": "Indigo on the Beach holds a barbecue on Thursday evenings.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-7",
      "text": "The Jetty Grill serves Caribbean dishes overlooking the resort's jetty and horseshoe bay.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-8",
      "text": "The resort also offers authentic Antiguan cuisine.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-9",
      "text": "CARA Spa offers holistic treatments, regular yoga classes and intensive health retreats.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-10",
      "text": "Breakfast in the suite is complimentary, with a tray charge.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-11",
      "text": "Guests can go sailing on the resort's yacht or kayak, and The Jetty Bar greets them back ashore.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Indigo on the Beach is an open-sided room and terrace with wooden floors that merge with the sand and sea.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "East serves Japanese, Thai and Indonesian dishes and is entered through tall, carved Indonesian doors.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-3",
      "text": "CARA Spa partners with GROUND Wellbeing, an Irish wellness brand, on rituals for sleep, stress relief, hormonal balance and skin health.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-4",
      "text": "Fire Pit Fridays at The Jetty Grill feature local singers and songwriters.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-5",
      "text": "Ottimo! is a poolside Italian restaurant with a wood-fired pizza oven and a Little Ottimo! menu for younger guests.",
      "source_ids": [
        "s10"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Restaurant opening days are subject to change, so the resort advises booking ahead.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes premium pricing and a remote island location that requires additional travel planning.",
