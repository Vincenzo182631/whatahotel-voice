  "name": "Amandari",
  "location": {
    "city": "Ubud",
    "country": "Indonesia"
  },
  "category": "other",
  "positioning": "Aman resort in Kedewatan village north of Ubud, designed after a traditional Balinese village on the edge of the Ayung River Gorge",
  "best_for": [
    "Travelers who want a village-style Bali retreat close to Ubud's cultural centre",
    "Guests drawn to Balinese ceremony, dance and cuisine"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The resort was designed after a traditional Balinese village on the edge of the Ayung River Gorge.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The resort is close to the artistic centre of Ubud.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Amandari sits in Kedewatan village, north of Ubud centre.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-4",
      "text": "Amandari was the first luxury hotel in Ubud and the second Aman.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "Every suite has a sunken outdoor marble tub large enough for two.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-6",
      "text": "Every suite has a private bale, a small open-air pavilion.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-7",
      "text": "The resort has one restaurant, called The Restaurant.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "Amandari offers a Ngejot Balinese Feast at The Restaurant at dinner time.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "Stays include daily traditional afternoon tea.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-10",
      "text": "Guests can join a daily Balinese dance and rindik class with children from Kedewatan village.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-11",
      "text": "The spa has two open-air treatment bales surrounded by lotus ponds.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-12",
      "text": "The resort has a tennis court with all equipment provided.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Amandari claims the first infinity pool in Bali.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-2",
      "text": "The resort does not use golf carts to shuttle guests around.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-3",
      "text": "Guests can go with a tour guide to Tirta Empul for an early-morning melukat purification ceremony before it opens to the public.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-4",
      "text": "Suites have no TV on the wall; one is available on request.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Amandari's spa is small.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "Reaching most of the resort, including The Restaurant, requires climbing steps.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-3",
      "text": "The airport transfer is a one and a half hour drive.",
      "source_ids": [
        "s6"
      ]
    }
  ],
