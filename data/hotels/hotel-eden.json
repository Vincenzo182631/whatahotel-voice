  "category": "urban",
  "positioning": "Dorchester Collection hotel in Rome, first opened in 1889, set between the Villa Borghese gardens and Via Veneto, with two restaurants and a bar on its rooftop",
  "best_for": [
    "Travelers who want rooftop dining and drinks with views over Rome",
    "Visitors wanting a base a short walk from the Spanish Steps"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Hotel Eden first opened in 1889.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The Spanish Steps are a 5-minute walk from the hotel.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel sits between the Villa Borghese gardens and Via Veneto.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-4",
      "text": "La Terrazza, Il Giardino Ristorante and Il Giardino Bar are all on the hotel's rooftop.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "La Terrazza is the hotel's fine dining restaurant on the top floor, with views over Rome.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-6",
      "text": "Il Giardino Ristorante is a relaxed rooftop restaurant above the Spanish Steps, open daily.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-7",
      "text": "La Libreria has a secret bar behind mirrored doors.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "La Libreria hosts regular workshops and exhibitions and has a curated collection of books.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-9",
      "text": "The spa offers Valmont and HöbePergh treatments.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-10",
      "text": "The fitness room is separate from the spa and open 24 hours a day.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-11",
      "text": "Dorchester Collection acquired the Eden in 2013 and revamped it, adding a spa and a rooftop restaurant.",
      "source_ids": [
        "s9"
      ],
      "expires": "2027-10-09"
    },
    {
      "id": "f-12",
      "text": "The Prestige Rooms with View and Balcony are on the fifth floor, each with a private balcony.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Il Giardino Bar has a vertical garden wall made from hundreds of handmade metal leaves.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "From the Pincian Hill, the views from Il Giardino Bar stretch from St Peter's to the Borghese gardens.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-3",
      "text": "Each month a new guest chef creates a Sunday lunch menu for Il Giardino Ristorante with chef Salvatore Bianco, in the Taste Society series.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "In the spa, each guest has a dedicated suite with a private changing room and bathroom.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Hotel Eden does not have a pool.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-2",
      "text": "There is no on-site parking; the hotel offers valet parking in a private garage nearby.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-3",
      "text": "The Vatican is around a 30-minute drive away.",
      "source_ids": [
        "s2"
      ]
    }
  ],
