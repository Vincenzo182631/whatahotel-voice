  "category": "urban",
  "positioning": "Hotel in a restored 15th-century convent on Via Gesù, in Milan's Fashion District",
  "best_for": [
    "Travelers who want a base near via Montenapoleone and via della Spiga",
    "Guests who want a spa with a heated indoor pool"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Four Seasons Hotel Milano is housed in a meticulously restored 15th-century convent on Via Gesù.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel offers 118 guest rooms.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel's guest rooms include 50 luxury suites.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-4",
      "text": "The hotel opened in April 1993.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-5",
      "text": "The hotel is located in the heart of Milan's Fashion District.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-6",
      "text": "The hotel is tucked quietly away between via Montenapoleone and via della Spiga.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "Via Montenapoleone is a two-minute walk from the hotel.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-8",
      "text": "Teatro alla Scala is a seven-minute walk from the hotel.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-9",
      "text": "The Montenapoleone Metro station (Yellow Line M3) is a three-minute walk from the hotel's front doors.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-10",
      "text": "Zelo is the hotel's gourmet Italian restaurant.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-11",
      "text": "Stilla cocktail bar is open all day.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-12",
      "text": "The spa has a 14-metre heated indoor pool.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-13",
      "text": "The spa has seven private treatment rooms.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-14",
      "text": "Premium Wi-Fi is listed among the hotel's complimentary services.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The spa was designed by Patricia Urquiola.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-2",
      "text": "The spa is set beneath historic 15th-century vaulted brick ceilings.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-3",
      "text": "The Fresco Suite features a ceiling frescoed by Giocondo Albertolli.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-4",
      "text": "Zelo has views of the historic 15th-century courtyard garden.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-5",
      "text": "The hotel's inner courtyard was once a garden where the convent's residents grew herbs and greens.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-6",
      "text": "The Renaissance Suite has a ceiling with original Renaissance stucco.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Children are allowed at the pool from 10:00 am to 12:00 noon and 2:00 pm to 4:45 pm.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel is within Milan's restricted traffic zone (Area C).",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "Children 12 and older are welcome at the spa when accompanied by a parent.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-4",
      "text": "WhataHotel notes that the historic building architecture may mean smaller room layouts.",
      "source_ids": [
        "s1"
      ]
    }
  ],
  "perks": [
