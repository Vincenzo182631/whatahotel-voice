  "category": "beach",
  "positioning": "The Ritz-Carlton, Langkawi: a resort in a private bay with rainforest grounds, designed around local architecture and a spa with overwater pavilions",
  "best_for": [
    "Families who want a kids program built around nature and culture",
    "Travelers who want a spa and private pool villas in a rainforest and beach setting"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The resort sits in a private bay on grounds that include a 10-million-year-old rainforest and beaches.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The resort's design is inspired by local architecture and indigenous art.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Philippe Villeroux of Tropical Area Architects designed the resort, which reflects local kampong village life.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-4",
      "text": "Hai Yan serves Chinese cuisine.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "Guests receive complimentary breakfast during their stay.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "The SkyCab cable car and Temurun Waterfall are a 10-minute walk from the resort.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "Spa treatments require an appointment.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The spa has six overwater pavilions.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "Mutiara Villa has three bedrooms, two private pools and access to its own private beach.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-3",
      "text": "The resort runs a sea cucumber nursery led by its marine biologist, where guests can take part hands-on.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-4",
      "text": "The resort offers a private catamaran cruise aboard Dayang Mastura to secluded beaches and coves.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The resort is large enough that golf cart service is offered to get around.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "Guests must be at least 18 years old to have spa treatments.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes the island location requires additional travel planning.",
