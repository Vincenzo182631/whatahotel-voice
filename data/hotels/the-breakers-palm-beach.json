  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The architecture of The Breakers is styled after the Italian Renaissance.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-2",
      "text": "The Breakers was founded by Henry Morrison Flagler.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel is still owned by Henry Flagler's heirs.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-4",
      "text": "The Breakers' Beach Club has four pools and a private beachfront.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "The Active Pool is a zero-entry pool suited to families.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-6",
      "text": "Poolside bungalows at the Beach Club can be rented for the day.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "The Ocean Fitness center sits above the Beach Club and has 10-foot-tall arched windows facing a terrace and the Atlantic.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "The resort has two golf courses, one with 18 holes and one with nine.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-9",
      "text": "The racquet complex has 12 tennis courts, two pickleball courts and two padel courts.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-10",
      "text": "The Shops at The Breakers surround the Palm Courtyard just beyond the lobby.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-11",
      "text": "Master sommelier Virginia Phillips heads the hotel's 55,000-bottle wine cellar.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-12",
      "text": "Guests can use complimentary resort bicycles.",
      "source_ids": [
        "s11"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Breakers is home to Florida's oldest golf course.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "Italian artisans hand-painted the hotel's fresco ceilings.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "h-3",
      "text": "The racquet club has four hydroponic grass tennis courts, described as the first installation worldwide of that court technology.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-4",
      "text": "The spa is an indoor-outdoor spa.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-5",
      "text": "The Adult Pool is infinity-style and reserved for guests 21 and older.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
