{
  "slug": "ritz-carlton-nikko",
  "whatahotel_id": 4182,
  "whatahotel_url": "https://www.whatahotel.com/hotels/4182/the-ritz-carlton-nikko.html",
  "name": "The Ritz-Carlton, Nikko",
  "location": {
    "city": "Nikko",
    "country": "Japan"
  },
  "category": "mountain",
  "positioning": "Ritz-Carlton hotel in Nikko National Park with lake and mountain views and an onsen hot-spring facility",
  "best_for": [
    "Travelers who want hot-spring soaks with lake and mountain views",
    "Guests interested in Japanese cultural activities such as zazen and woodcarving"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel sits within Nikko National Park, with views of Lake Chuzenji and Mount Nantai.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Each room and suite has an engawa, or porch, and a lake or mountain view.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "Rooms have a genkan foyer for removing shoes, a traditional engawa and a Zen rock garden.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Bathrooms are clad in local Oya stone.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-5",
      "text": "The restaurants use local ingredients sourced from farms in Tochigi Prefecture.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-6",
      "text": "The Japanese Restaurant serves a multicourse kaiseki dinner on local Mashiko ware.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-7",
      "text": "The onsen has indoor and outdoor hot-spring baths.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "Guests with a spa appointment can reserve a private outdoor hot-spring pool.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-9",
      "text": "Tattoos are welcome at the onsen.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "A 10-minute walk from the hotel leads to Kegon waterfall.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel's onsen is the first hot spring for the Ritz-Carlton brand, with water sourced from Yumoto Onsen.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "The Bar chills its cocktails with natural highland ice harvested at Nikko's Tokujiro Ice Farm.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Guests can take a Nikko-bori woodcarving class led by the mother-daughter duo who created the wall carvings in the Japanese restaurant.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-4",
      "text": "The hotel offers a morning zazen session led by a monk from nearby Chuzenji Temple.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "From Nikko station it is about a 40-minute drive along winding mountain roads to the hotel.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel does not provide shuttle service; airport transfer is by limousine, which requires a reservation and a fee.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-3",
      "text": "Guest activities must be reserved at the front desk by 4 p.m. on the day before.",
      "source_ids": [
        "s7"
      ]
    }
  ],
