  "name": "The Artist Grand Hotel of Art  Bilbao",
  "location": {
    "city": "Bilbao",
    "country": "Spain"
  },
  "category": "urban",
  "positioning": "Art-filled hotel opposite the Guggenheim Museum in Bilbao, officially The Artist - Grand Hotel of Art, with Javier Mariscal's work throughout",
  "best_for": [
    "Art and design lovers visiting the Guggenheim Museum",
    "Travelers bringing their pet"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel is located opposite the Guggenheim Museum.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel is in Bilbao's artistic district, about 500 meters from the Museum of Fine Arts.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel opened in 2002.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "The project was carried out by architecture studio IA+B with artist Javier Mariscal and Fernando Salas.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Javier Mariscal's work runs through every corner of the hotel.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "The rooms house contemporary artworks, and some have windows looking onto the Guggenheim.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "The wellness area offers a sauna, treatments and massages.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-8",
      "text": "The hotel has a fully equipped gym.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-9",
      "text": "Pets are welcome, with adapted rooms, an extra bed, bowls and outdoor areas.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-10",
      "text": "At the restaurant Olio, Abel Corral and Nelson Da Silva celebrate Basque-French cuisine.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-11",
      "text": "The Sixty-One lobby bar hosts live jazz concerts.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-12",
      "text": "The hotel has private, secure parking with electric vehicle charging points and valet parking included.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel describes itself as Spain's first entirely author-designed hotel.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-2",
      "text": "Smart Inner View rooms look onto Javier Mariscal's stone cypress in the hotel's atrium.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "The lobby has a kinetic installation custom-made by the Swedish studio Humans Since 1982.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-4",
      "text": "The Rooftop has views of the Guggenheim Museum and is where guests have breakfast.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-5",
      "text": "The Penthouse Suite has two separate rooms and a private terrace overlooking the Guggenheim Museum.",
      "source_ids": [
        "s4"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Parking is charged, with the price covering the space and valet service.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "The Rooftop brunch is held only once a month, on special dates.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes limited on-site recreational facilities compared to larger hotels.",
      "source_ids": [
        "s1"
      ]
    }
  ],
