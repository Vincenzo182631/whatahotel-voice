  "whatahotel_url": "https://www.whatahotel.com/hotels/2664/the-ritz-carlton-vienna.html",
  "name": "The Ritz-Carlton, Vienna",
  "location": {
    "city": "Vienna",
    "country": "Austria"
  },
  "category": "urban",
  "positioning": "Luxury hotel in four linked 19th-century palaces on Vienna's Ringstrasse, next to the Stadtpark",
  "best_for": [
    "Travelers who want a historic Ringstrasse address next to the Stadtpark",
    "Guests interested in Vienna's music and art, such as the Symphony and Albertina suites"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel is on Vienna's Ringstrasse, adjacent to the Stadtpark.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel occupies four linked, heritage-protected 19th-century palaces built between 1865 and 1871.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "The lobby is in the building at Schubertring 5, which was originally built as the Adels Casino.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Dstrikt Steakhouse and the D-bar are located in the historical building.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Pastamara - Bar con Cucina is a Sicilian-inspired restaurant led by Chef Ciccio Sultano.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "Atmosphere Rooftop Bar is on the eighth floor and overlooks the city.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-7",
      "text": "The ANGATI Spa has an indoor pool, steam room and sauna.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-8",
      "text": "The Club Lounge offers complimentary food and beverage presentations five times each day.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel is pet-friendly.",
      "source_ids": [
        "s9"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Presidential Suite, in the former Palais Gutmann, preserves August Eisenmenger's ceiling fresco The Twelve Months.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-2",
      "text": "Guests of the Symphony Suite are offered a VIP visit to general rehearsals of the Wiener Symphoniker, the Vienna Symphony Orchestra.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Guests of the Albertina Suite get free admission and skip-the-line tickets to the Albertina Museum.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "A guided Augarten Porcelain Manufactory experience lets guests create their own porcelain piece, followed by afternoon tea.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Club access requires an upgraded booking, and Marriott Bonvoy Elite status does not provide complimentary access.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "The hotel does not provide an airport shuttle service.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes a formal atmosphere that may not suit all travelers.",
      "source_ids": [
        "s1"
      ]
    }
  ],
