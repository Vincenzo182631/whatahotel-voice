  "category": "urban",
  "positioning": "Contemporary design hotel near Parque Eduardo VII and Avenida da Liberdade, with local art throughout, a rooftop pool bar and KORPO Spa",
  "best_for": [
    "Travelers who want a central Lisbon base close to Avenida da Liberdade shopping",
    "Guests interested in contemporary Portuguese art and design",
    "Travelers who want a rooftop pool and a spa in the city"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "ME Lisbon is a few steps from Parque Eduardo VII and the boutiques of Avenida da Liberdade.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel is 0.3 km from Marques de Pombal.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Superior ME rooms include local art, a selection of art and fashion books, CO-Bigelow toiletries and coffee.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Ceramic pieces by Elsa Rebelo are displayed in the rooms and suites.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-5",
      "text": "A site-specific sculpture by Fernanda Fragateiro, Wave, evokes the River Tejo.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Attiko serves Japanese robata, creative sushi and pan-Asian fusion cuisine, with views of Marques de Pombal square and the city centre.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "Fismuler celebrates honest cooking, with curated ingredients and natural fermentation, in a raw, elegant space.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-8",
      "text": "KORPO Spa offers Thalion and Scens wellness treatments.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-9",
      "text": "The gym is available 24/7.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-10",
      "text": "Guests can bring their dog by adding the pet-friendly service, available on request at an additional cost.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Through The Culture Collective, the hotel's spaces become a living exhibition, with immersive events by artists from Lisbon's cultural scene.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "The Attiko Rooftop Pool Bar on the 13th floor offers 360-degree views of Lisbon.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-3",
      "text": "Rooms and suites have contemporary design, with panoramic views of Lisbon's historic neighbourhoods and monuments.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "KORPO Spa has a sauna, steam room, sensory shower and an indoor pool.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-5",
      "text": "The Extra ME+ Junior Suite with Terrace has a spacious terrace with Kettal outdoor furniture.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The Attiko rooftop pool bar area is closed during the winter season.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-2",
      "text": "KORPO Spa has two treatment rooms.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes potential street noise in some rooms, given the urban setting.",
