  "highlights": [
    {
      "id": "h-1",
      "text": "On cloudless days, Mount Fuji glistens in the distance from the Mandarin Grand Rooms.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "h-2",
      "text": "The lobby check-in desk is backdropped by an eastern outlook through floor-to-ceiling windows.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "h-3",
      "text": "The Sushi Shin by Miyakawa counter is made from a 350-year-old cypress tree.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "h-4",
      "text": "The Spa offers Heat & Water experiences with a panoramic view of the Tokyo skyline.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-5",
      "text": "All rooms and suites feature spacious marble bathrooms with a deep soaking tub.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "It is Japanese custom to bathe without clothing within the Heat & Water areas of the spa.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "c-2",
      "text": "The minimum age for access to the spa and fitness centre is 16.",
