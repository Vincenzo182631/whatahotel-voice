  "name": "Hotel de Russie",
  "location": {
    "city": "Rome",
    "country": "Italy"
  },
  "category": "urban",
  "positioning": "Rocco Forte hotel in central Rome, between Piazza del Popolo and the Spanish Steps, with rooms designed by Olga Polizzi",
  "best_for": [
    "Travelers who want a base between Piazza del Popolo and the Spanish Steps",
    "Families, with a kids programme tailored for babies, kids and teens"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Hotel de Russie sits between Piazza del Popolo and the Spanish Steps in Rome.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The rooms were designed by Olga Polizzi.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The Italian cuisine at Le Jardin is overseen by Chef Fulvio Pierangelini.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-4",
      "text": "The Stravinskij Bar's 'Rome in a Sip' cocktail menu was created by Maestro Salvatore Calabrese and Mattia Capezzuoli.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "Aquazzura Bar serves tequila cocktails paired with small bites by Fulvio Pierangelini.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Irene Forte Spa has a saltwater hydro pool, a sauna and a steam room.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-7",
      "text": "The spa includes a gym with Technogym equipment.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-8",
      "text": "Signature spa treatments use Irene Forte Skincare, with ingredients from the brand's organic farm at Verdura Resort in Sicily.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-9",
      "text": "The Rocco Forte Kids programme is tailored for babies, kids and teens.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-10",
      "text": "Baby meals are complimentary.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-11",
      "text": "Forte Suite benefits include a return transfer to and from the airport.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-12",
      "text": "The Valadier Suite has floor-to-ceiling windows and a French balcony overlooking Pincian Hill and the hotel's Secret Garden.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Picasso stayed at the hotel for several months in 1917, and the Picasso Suite with Terrace is named for him.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-2",
      "text": "The Nijinsky Suite with Terrace pays tribute to ballet dancer and choreographer Vaslav Nijinsky, who was a frequent visitor to the hotel.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Le Jardin has an outdoor terrace at the foot of the Pincio, surrounded by mature pine and flowering citrus.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "The Stravinskij Bar is set around an intimate open-air piazzetta.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-5",
      "text": "Aquazzura Bar was created by Lydia Forte and Edgardo Osorio.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The restaurants have no dress code but ask guests to avoid sportswear, shorts and beach shoes.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-2",
      "text": "Babysitting is available around the clock on request, subject to a supplement.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes that the historic building has some smaller room sizes.",
      "source_ids": [
        "s1"
      ]
    }
  ],
