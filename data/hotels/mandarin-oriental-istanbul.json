  "facts": [
    {
      "id": "f-1",
      "text": "The hotel's address is Kuruçeşme, Muallim Naci Caddesi No: 62, 34345 Beşiktaş/İstanbul, Turkey.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel is on the European shores of the Bosphorus, between Ortaköy and Bebek.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The hotel has panoramic Bosphorus views including 15 July Martyrs Bridge, Fatih Sultan Mehmet Bridge, Beylerbeyi Palace and the Kuleli Military Academy.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Novikov Istanbul is a ground-floor restaurant on the Bosphorus shoreline serving Italian, Asian and Mediterranean cuisine.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-5",
      "text": "Olea & Bar serves Italian cuisine and offers a view of the Bosphorus.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-6",
      "text": "Bosphorus Lounge offers afternoon tea, a Turkish coffee service and a cocktail list.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-7",
      "text": "The spa facilities include an indoor pool, steam room, sauna, jacuzzi and a zen garden.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "The hotel has an outdoor lap pool with views over the Bosphorus.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel has a designated children's pool.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-10",
      "text": "Valet parking is available on site for hotel guests.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-11",
      "text": "The hotel is flanked by two parks.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-12",
      "text": "The hotel offers electric cars for airport transfers or short-distance trips, booked through the Concierge Desk.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-13",
      "text": "The Family Room features two connecting rooms.",
      "source_ids": [
        "s12"
      ]
    }
  ],
  "highlights": [
