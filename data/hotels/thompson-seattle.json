  "category": "urban",
  "positioning": "Thompson Seattle, by Hyatt: a glass-fronted hotel by Olson Kundig where downtown Seattle meets Belltown, a short walk from Pike Place Market",
  "best_for": [
    "Travelers who want to walk to Pike Place Market",
    "Guests who want a rooftop bar with views of Elliott Bay",
    "Travelers bringing a dog"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel sits at the connection of downtown Seattle and Belltown.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Pike Place Market is 0.13 miles from the hotel.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Rooms have hardwood floors, midcentury furniture and rainfall showers.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Rooms have Sferra linens and D.S. & Durga bath toiletries.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "The Penthouse Suites look out over Pike Place Market and Elliott Bay.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-6",
      "text": "Conversation Kitchen & Bar is the hotel's all-day restaurant downstairs, specializing in seafood, desserts and cocktails.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "Executive Chef Chris Ingmire marries Pacific Northwest abundance with his experience in kitchens across the country.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "Weekend Booze & Brunch is served on Saturdays and Sundays.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel welcomes dogs at no additional charge.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-10",
      "text": "The hotel has 10,000 square feet of meeting space across six indoor and outdoor venues.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-11",
      "text": "The nearest public transit hub is Westlake Station, served by Link light rail, the South Lake Union Streetcar and the Seattle Center Monorail.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-12",
      "text": "Seattle-Tacoma International Airport is 15 miles from the hotel.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The Nest is the hotel's rooftop bar, cocktail lounge and terrace, with views of Elliott Bay and the Olympic Mountain Range.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The hotel has an angular glass exterior designed by local firm Olson Kundig.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-3",
      "text": "Rooms feature floor-to-ceiling windows with views of Pike Place Market, Puget Sound and the Olympic Mountains.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "The Taste of Thompson dinner party menu centers on a tomahawk steak cooked in a Penthouse Suite's kitchen.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "A daily destination fee applies to each room.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-2",
      "text": "The Nest rooftop bar is for ages 21 and over only.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "c-3",
      "text": "The hotel has a small fitness center.",
      "source_ids": [
