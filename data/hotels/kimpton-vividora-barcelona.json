  "facts": [
    {
      "id": "f-1",
      "text": "Kimpton Vividora is the first Kimpton in Spain and is located in the Gothic Quarter.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel sits right next to Las Ramblas and within walking distance of Barceloneta beach.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Rooms use a Mediterranean color palette, natural materials and design pieces from local artisans.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-4",
      "text": "Terraza de Vivi is a rooftop terrace and bar with views over the city, serving cocktails with live music by local artists.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "Fauna restaurant serves Mediterranean flavours with Catalan roots, by chef Jordi Delfa.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-6",
      "text": "GOT Coffee & Cocktails is a cafe by day that becomes a bar with natural wines, artisanal vermouth and cocktails at night.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "Terraza de Vivi serves a brunch with bottomless mimosas and Bloody Marys.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "The outdoor pool is next to Terraza de Vivi, the hotel's terrace and bar.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-9",
      "text": "The fitness room is equipped with Technogym.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "The hotel has a Wellness Room curated by Signature Spa.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-11",
      "text": "Pets of any size, weight or breed are welcome at no extra charge.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-12",
      "text": "The hotel offers complimentary bikes and longboards for guests to explore the city.",
      "source_ids": [
        "s2"
      ]
    }
  ],
