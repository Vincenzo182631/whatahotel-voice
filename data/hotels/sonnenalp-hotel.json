  "facts": [
    {
      "id": "f-1",
      "text": "The Sonnenalp Hotel is located in the heart of Vail Village.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Every suite and hotel room has a view of either Gore Creek or Vail Village.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Each suite has a bedroom and a living room area.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "Many suites feature gas fireplaces, balconies and heated marble bathroom floors.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Swiss Chalet serves Swiss cuisine including fondue, raclette and schnitzel.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "Swiss Chalet reflects Sonnenalp's Bavarian heritage.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-7",
      "text": "King's Club serves cocktails with live entertainment beside a roaring fireplace.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "Bully Ranch offers indoor and outdoor dining with Colorado-inspired dishes, burgers and salads.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-9",
      "text": "The spa's indoor and outdoor whirlpools look out over Gore Creek.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-10",
      "text": "The spa has a cafe and an oxygen bar.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The Sonnenalp Kids Club offers arts and crafts sessions and outdoor excursions.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-12",
      "text": "Through Gorsuch, the ski concierge provides ski, snowboard and helmet rentals and demos.",
      "source_ids": [
        "s11"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Breakfast is served on Ludwig's glass-enclosed terrace overlooking Gore Creek.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The Sonnenalp Ski Concierge has a private lounge with secure lockers at Gorsuch Ski Cafe.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-3",
      "text": "Gorsuch Ski Cafe is 50 steps from Gondola One.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-4",
      "text": "The spa has a heated indoor and outdoor pool with a riverfront sun deck and a summer pool bar.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-5",
      "text": "Hotel guests have preferred access to tee times at the Sonnenalp Club golf course.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "considerations": [
