  "facts": [
    {
      "id": "f-1",
      "text": "The hotel is in the Deep Ellum neighborhood of Dallas, near breweries, galleries, eateries and music venues.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-2",
      "text": "The Dallas Museum of Art, the Nasher Sculpture Center and the Crow Museum of Asian Art are nearby.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-3",
      "text": "Rooms use a palette of white walls with pops of dark green, orange and gray, plus local artwork.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "Bathrooms feature subway tile, marble and wood.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "The suites include the Historic Sydney Suite, the Historic Pythias Suite, the Epic Suite and a Presidential Suite.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-6",
      "text": "Elm & Good is the hotel's modern American tavern and social lounge.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "The Elm & Good menu is ingredient-driven, with seasonal meat and seafood dishes and globally inspired dishes.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-8",
      "text": "The pool area has lounge chairs and cabanas.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel pairs a century-old Beaux Arts exterior with modern glass and steel interiors.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-2",
      "text": "In the evening, the pool deck has communal fires and live music.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Deep End is an outdoor bar by the pool deck serving cocktails, local craft beers and bites.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "Pets of any size, weight or breed are welcome at no extra charge.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-5",
      "text": "The hotel has a seasonally heated outdoor pool.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Overnight valet parking costs $55 per night for hotel guests.",
