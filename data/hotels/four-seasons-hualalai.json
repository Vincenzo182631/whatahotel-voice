  "facts": [
    {
      "id": "f-1",
      "text": "The resort opened in September 1996.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "The resort is on a half-mile stretch of beach on the northwest Kona Coast of Hawaii's Big Island.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "The resort's design is low-rise bungalows in mid-20th-century Hawaiian style.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-5",
      "text": "The resort has eight pools.",
      "source_ids": [
        "s2",
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "King's Pond is a 1.8-million-gallon swimmable aquarium.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-8",
      "text": "The Hualalai Golf Course was designed by Jack Nicklaus.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-9",
      "text": "The resort has seven tennis courts.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-10",
      "text": "'ULU serves Pan-Asian, Hawaiian-inspired cuisine.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-11",
      "text": "Beach Tree serves California Italian cuisine.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "NOIO has an ocean-view omakase counter with 12 seats.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "Miller & Lux Hualalai is a dining experience by Chef Tyler Florence.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Beach Tree offers nightly live entertainment.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "The Kumu Kai Marine Center is led by a team of on-site marine biologists.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-5",
      "text": "The Palm Grove Pool is an adults-only infinity edge pool with a swim-up bar.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-6",
      "text": "The Kahuwai Suite has an infinity-edge pool overlooking Kumukea Beach.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The resort is a half-hour drive from the city of Kailua-Kona.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-3",
      "text": "Helicopter tours are listed among the resort's off-site activities.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-4",
      "text": "WhataHotel notes the resort's location on the Big Island requires inter-island travel from Honolulu.",
      "source_ids": [
