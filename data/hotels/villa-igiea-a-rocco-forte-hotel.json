{
  "slug": "villa-igiea-a-rocco-forte-hotel",
  "whatahotel_id": 3317,
  "whatahotel_url": "https://www.whatahotel.com/hotels/3317/villa-igiea-a-rocco-forte-hotel.html",
  "name": "Villa Igiea, a Rocco Forte Hotel",
  "location": {
    "city": "Palermo",
    "country": "Italy"
  },
  "category": "beach",
  "positioning": "Rocco Forte hotel in a Belle Epoque palazzo built in 1900, at the foot of Mount Pellegrino on the Gulf of Palermo",
  "best_for": [
    "Travelers who want a seaside base on the edge of Palermo",
    "Guests drawn to Belle Epoque history and Sicilian dining",
    "Families who want a pool and tennis courts"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Villa Igiea was built in 1900, at the height of the Belle Epoque.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-2",
      "text": "The Florio family turned Villa Igiea from a private palazzo into a hotel.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-3",
      "text": "The palazzo sits at the edge of Palermo, at the foot of Mount Pellegrino on the Gulf of Palermo.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "The Florio Restaurant menu is designed by Chef Fulvio Pierangelini.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "Alicetta is a bistro on terraces between the garden and the sea.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "Aperitivo hour at the bar takes place in the villa's sandstone vaults, with a wide selection of Florio liqueurs.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-7",
      "text": "The Donna Franca Suite has a separate living room and a sea-view terrace with lounges and sunbeds.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-8",
      "text": "Rocco Forte took over Villa Igiea in 2019.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-9",
      "text": "The rooms reflect the design of Olga Polizzi, Rocco Forte's sister.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-10",
      "text": "The Irene Forte spa uses Irene Forte skincare, made with botanicals from the Verdura Resort farm.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-11",
      "text": "The hotel has a pool and tennis courts.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-12",
      "text": "The hotel offers boat trips along the Mondello coast that include the Capo Gallo Nature Reserve.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The George V Suite is named after King George V, who stayed at the villa during his 1925 visit to Sicily.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-2",
      "text": "Florio Restaurant is set in the villa's historic Louis XVI hall.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Alicetta is enclosed in a metal pavilion modelled on the pavilion of the Palazzo Butera.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-4",
      "text": "Igiea Terrazza Bar overlooks the Gulf of Palermo and is set among 1950s frescoes.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-5",
      "text": "The villa was used as a film backdrop by de Sica and Sordi.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The hotel is on the coast, about a 15-minute drive from central Palermo, in a suburban neighborhood.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-2",
      "text": "WhataHotel notes premium luxury pricing typical of high-end heritage properties.",
      "source_ids": [
        "s1"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes the historic building may have limited modern amenities in some areas.",
      "source_ids": [
        "s1"
      ]
    }
  ],
