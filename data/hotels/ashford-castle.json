  "facts": [
    {
      "id": "f-1",
      "text": "Ashford Castle is surrounded by a 350-acre estate of gardens, forests and woodland overlooking the shores of Lough Corrib in County Mayo.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Ashford Castle is in Cong, County Mayo.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Ashford Castle was once home to the Guinness family.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "Ashford Castle is part of The Red Carnation Hotel Collection.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Condé Nast Traveler says the castle has been around since 1228.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-6",
      "text": "Fine dining is served in the George V Dining Room, where breakfast is also served daily.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "The Dungeon serves grill classics.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "Afternoon Tea is served in the Connaught Room.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "Spa facilities include a relaxation pool, a Hammam, a steam room and a fitness suite.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "Estate activities include horse riding, fishing, falconry, shooting, golf and cycling.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The estate has a 9-hole parkland golf course.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-12",
      "text": "Guests can play on two all-weather tennis courts free of charge.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Accommodation includes the historic Boathouse, perched over the lake.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-2",
      "text": "Squire Danagher's is a private dining experience in the original house where The Quiet Man was filmed in the 1950s, with traditional Irish entertainment.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "Guests can try falconry with the estate's experts, with no previous experience necessary.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-4",
      "text": "The Spa has a 'Tree of Life' mural stretching the length of the relaxation pool.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-5",
      "text": "The castle's wine cellar is kept in its secret passageways.",
      "source_ids": [
        "s9"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Ashford Castle is 155 miles from Dublin.",
