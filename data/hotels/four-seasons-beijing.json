        "s2",
        "s3"
      ]
    },
    {
      "id": "f-4",
      "text": "The hotel is at 48 Liang Ma Qiao Road in the Chaoyang District of Beijing.",
      "source_ids": [
        "s3",
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "The hotel is in the Liangma area of the Chaoyang District, home to most of the city's foreign embassies.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-6",
      "text": "Cai Yi Xuan is the hotel's Michelin-starred Cantonese restaurant.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "Mio is the hotel's Michelin-selected Italian restaurant.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "Opus Lounge is an all-day lounge that serves afternoon tea.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "Opus Bar serves signature cocktails and wines.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-10",
      "text": "The hotel has a naturally lit indoor pool.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The Executive Club Lounge is on the 26th floor.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel's central atrium has 384 stainless-steel butterflies.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-2",
      "text": "The Tea Garden sits beneath the butterfly wall and is reminiscent of a Beijing courtyard.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-3",
      "text": "The spa's couple's suite has a private bath and side-by-side treatment beds.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-4",
      "text": "The three-bedroom Imperial Suite takes up the entire 27th floor.",
      "source_ids": [
        "s3"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The hotel is a 30 minute drive from the Forbidden City.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "c-2",
      "text": "Most local taxi drivers don't speak or read English, so guests are advised to show the address in Chinese.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes a busy urban location with city traffic and noise.",
