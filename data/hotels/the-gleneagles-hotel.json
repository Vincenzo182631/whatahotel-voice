{
  "slug": "the-gleneagles-hotel",
  "whatahotel_id": 1446,
  "whatahotel_url": "https://www.whatahotel.com/hotels/1446/the-gleneagles-hotel.html",
  "name": "The Gleneagles Hotel",
  "location": {
    "city": "Perthshire",
    "country": "Scotland"
  },
  "category": "other",
  "positioning": "Gleneagles, a country-estate hotel opened in 1924 on 850 acres in Perthshire, with championship golf and country pursuits",
  "best_for": [
    "Golfers who want championship courses on the estate",
    "Families with children who want kids' programmes and outdoor activities",
    "Travelers who want country pursuits such as fishing on the River Tay and hawking"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The Gleneagles estate covers 850 acres.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The golf clubhouse sits at the foot of the Ochil Hills.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Gleneagles opened in 1924, commissioned by the Caledonian Railway with a railway station of its own.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-4",
      "text": "The rooms are individually inspired by the mountains, meadows, rivers and lakes of the Perthshire countryside.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "The Strathearn serves modern Scottish dishes by candlelight, with traditional gueridon service and a grand piano.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-6",
      "text": "The Birnam has an Italian-leaning menu of handmade pasta and steaks cooked over open flame.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-7",
      "text": "The American Bar is a 1920s cocktail lounge.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-8",
      "text": "The Century Bar has 400 whiskies.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-9",
      "text": "The Gym and Swim facilities include two indoor pools, an outdoor thermal pool and a gym.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "The King's Course was designed by James Braid.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-11",
      "text": "The Gleneagles Sporting Club has 8 tennis courts and three padel courts.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-12",
      "text": "Little Glen Adventurers is a kids' programme for 3 to 7 year olds.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Gleneagles hosted the Ryder Cup in 2014.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-2",
      "text": "The Tower Suite has three levels of Art Deco design and a private rooftop terrace.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-3",
      "text": "Gleneagles has three championship golf courses and one 9-hole course.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-4",
      "text": "Country pursuits include fishing on the River Tay and hawking in the hills.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Gleneagles is about an hour from Edinburgh or Glasgow, and it has its own train station.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-2",
      "text": "The golf courses close from time to time for essential maintenance.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "c-3",
      "text": "All of the accessible rooms are in the Braid House wing.",
      "source_ids": [
        "s10"
      ]
    }
  ],
