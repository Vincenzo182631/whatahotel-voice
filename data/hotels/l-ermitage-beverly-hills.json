  "facts": [
    {
      "id": "f-1",
      "text": "L'Ermitage was established in 1975 on a palm-lined residential boulevard.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel sits in a quiet residential enclave within walking distance of Rodeo Drive.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "L'Ermitage is an all-suite hotel.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-4",
      "text": "Every suite has Frette linens, marble baths, dressing rooms and French balconies.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-5",
      "text": "Suites have walk-through dressing rooms with full-length triptych mirrors and expansive vanities.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-6",
      "text": "Heritage Suites have kitchenettes, dining areas, guest powder rooms and French balconies.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-7",
      "text": "Classic Suites have onyx marble baths with soaking tubs.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-8",
      "text": "Joanna Czech Studio, on the hotel's seventh floor, offers personalized facials, selective body treatments and brow services.",
      "source_ids": [
        "s5",
        "s6"
      ]
    },
    {
      "id": "f-9",
      "text": "The Salon by Alon Shalom offers cuts, color and styling within the hotel.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-10",
      "text": "The fitness center has Peloton bikes and Hydrow rowers, with personal trainers available.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-11",
      "text": "Poza is the rooftop restaurant and bar, serving seasonal Californian cuisine and handcrafted cocktails.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-12",
      "text": "Costa Covo serves coastal Mediterranean-inspired cuisine with seasonal California ingredients.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The seventh-floor L'Ermitage Suite has a screening room, private study, spa treatment room and professional kitchen.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The rooftop has a heated pool with panoramic views across Los Angeles.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "h-3",
      "text": "The fifth-floor Palm Suite has a full-service kitchen and multiple balconies overlooking the hotel's palm trees.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-4",
      "text": "Guests can reset in the SAVA Sound Pod by TERSA.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-5",
      "text": "The concierge can arrange guided Runyon Canyon hikes and Malibu surf lessons.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "considerations": [
