  "facts": [
    {
      "id": "f-1",
      "text": "Hotel Amigo is between the Grand-Place and Manneken Pis in Brussels.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Ristorante Bocconi serves authentic Italian cuisine as envisioned by chef Fulvio Pierangelini.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-3",
      "text": "Monochrome Fornasetti plates in individually painted frames decorate Bocconi's walls.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-4",
      "text": "Bocconi has a Milan-inspired terrace for aperitivo and Italian dining.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-5",
      "text": "Bocconi serves a Pranzo della Domenica lunch every Sunday.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Bar Magritte offers chess, live music and late nights.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-7",
      "text": "Le Joueur Gourmand is an afternoon tea at Bar Magritte that adds a touch of Belgian surrealism to the British tradition.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "The Blaton Suite has a private terrace overlooking the Grand-Place.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-9",
      "text": "The Presidential Suite is inspired by René Magritte's wit and imagination.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-10",
      "text": "The Family Room has two interconnecting bedrooms, separate bathrooms and family amenities.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-11",
      "text": "Individual or group running tours of Brussels are available on request through the concierge.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-12",
      "text": "The Fitness Centre has Technogym equipment and a full set of free weights.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "In the Diane von Furstenberg Suite's walk-in wardrobe, guests can try on two DVF wrap dresses.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The Tintin Suite invites guests of every age into Hergé's world.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-3",
      "text": "Mixologist Salvatore Calabrese created Bar Magritte's menu of 20 cocktails paying homage to René Magritte.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "h-4",
      "text": "In Bocconi's dining room, custom Adam Ellis artwork pays tribute to Italy's theatrical heritage with figures from the Commedia dell'Arte.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-5",
      "text": "The hotel's building is over 500 years old.",
      "source_ids": [
        "s8"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Classic Rooms overlook the hotel's courtyard; Deluxe Rooms look out over the cobblestone streets of the Old Town.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "c-2",
      "text": "There is no dress code, but the hotel asks guests not to wear sportswear, shorts or beach shoes in its restaurants.",
