  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The Matador Room is the signature restaurant, with a 1940s supper club-like atmosphere and cuisine inspired by South America, the Caribbean and Spain.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Matador Bar has black walnut-paneled walls with photographs from Lucien Clergue's Matador series.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "Market at EDITION is a food hall-inspired restaurant.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-4",
      "text": "Rooms are pet-friendly, with marble bathrooms and enclosed rainforest showers.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-5",
      "text": "Room service is available 24 hours.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "The hotel has two outdoor ocean-facing pools.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-7",
      "text": "The Spa at The Miami Beach EDITION offers massages, beauty treatments and lap pool sessions.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-8",
      "text": "The hotel is at 2901 Collins Avenue in Miami Beach.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel has a 2,000 square-foot indoor ice skating rink.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-2",
      "text": "The hotel has a four-lane bowling alley, Basement Bowl, with color-changing lighting effects.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-3",
      "text": "The Tropicale restaurant and bar is housed in the original landmarked Sundial restaurant and bar, now restored.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-4",
      "text": "The Lobby Bar has original gold and marble columns and a 1950s Miami Beach feel.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-5",
      "text": "Top-level bungalows have a roof deck with a private plunge pool.",
      "source_ids": [
        "s5"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Basement Bowl and Basement Skate enforce a 21+ rule after 9PM.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "WhataHotel notes the high-energy party atmosphere may not suit all guests.",
