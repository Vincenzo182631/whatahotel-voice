  "category": "urban",
  "positioning": "Dorchester Collection hotel on rue de Rivoli, opposite the Tuileries Garden, known as the hotel of artists since 1835, with Alain Ducasse and Cedric Grolet dining",
  "best_for": [
    "Travelers who want to stay opposite the Tuileries Garden, a short walk from the Louvre",
    "Food lovers drawn to Alain Ducasse's restaurant and Cedric Grolet's pastry",
    "Art and history lovers interested in the hotel's artistic past"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "Le Meurice is at 228 rue de Rivoli, opposite the Tuileries Garden and a five-minute walk from the Louvre.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-2",
      "text": "Le Meurice has been known as the hotel of artists and free spirits since 1835.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "The dining room of Restaurant le Meurice Alain Ducasse is inspired by the Salon de la Paix at Versailles and reinterpreted by Philippe Starck.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-4",
      "text": "Hotel guests dining at Restaurant le Meurice Alain Ducasse are welcomed with a complimentary glass of Dom Perignon 2017.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-5",
      "text": "Restaurant Le Dali serves seasonal French cuisine in an artistic setting designed by Philippe Starck.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-6",
      "text": "Chef Clementine Bouchon, chosen by Alain Ducasse, leads the kitchen at Le Dali with dishes that celebrate French classics.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-7",
      "text": "Cedric Grolet joined Le Meurice in 2011 and became its head pastry chef.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "f-8",
      "text": "Philippe Starck refreshed Bar 228 with a Carrara marble bar counter, keeping its dark woods and painted ceiling.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-9",
      "text": "The spa, La Maison Valmont pour Le Meurice, has hammams and a sauna.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-10",
      "text": "The fitness studio uses Technogym equipment.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-11",
      "text": "The Junior Suite is designed by Lally and Berger.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-12",
      "text": "The Deluxe Room, like many other rooms, can connect to an additional room or suite.",
      "source_ids": [
        "s11"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Pablo Picasso hosted his wedding banquet at Le Meurice.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "Bar 228 has live jazz every night.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-3",
      "text": "Cedric Grolet's tea time, with his Fruits Sculptes, is served in Restaurant Le Dali.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-4",
      "text": "The Superior Room, Eiffel View with Balcony sits under the Mansard roof and has a private balcony.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "h-5",
      "text": "From the hotel entrance you see the Louvre to the left and the Eiffel Tower to the right.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Cedric Grolet's pastry boutique is at 6 rue de Castiglione, not inside the hotel, and has no seating.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-2",
      "text": "Bar 228 does not take reservations except for hotel guests.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes ultra-luxury pricing that reflects the hotel's premium positioning.",
      "source_ids": [
        "s1"
      ]
    }
  ],
