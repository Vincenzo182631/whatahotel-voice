      ]
    },
    {
      "id": "f-4",
      "text": "Anderson's Cabin offers private dining for up to 10 guests.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-5",
      "text": "The spa has a grotto, a Himalayan salt wall dry sauna, a steam room and a cold plunge.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-6",
      "text": "The hotel runs a Ritz Kids program for children ages 5 to 12.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-7",
      "text": "The hotel offers a Ski Nanny Program for children's ski lessons.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-8",
      "text": "Complimentary transportation to Beaver Creek Village is available through the Village Connect app.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-9",
      "text": "Pets are welcome, with up to two pets per room.",
      "source_ids": [
        "s7"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Anderson's Cabin, above the hotel, is the original home of John Anderson, one of seven bachelors who settled the area in the 1900s.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "The spa's signature Miner's Mineral Mud Wrap uses activated charcoal sourced from Colorado mines.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-3",
      "text": "The hotel offers three- and four-bedroom penthouses for large gatherings of family and friends.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-4",
      "text": "The hotel's design draws on national park lodges, with timber beams and natural stone.",
      "source_ids": [
        "s8"
      ]
    }
  ],
