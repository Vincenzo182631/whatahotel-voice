  "name": "Beau-Rivage Palace",
  "location": {
    "city": "Lausanne",
    "country": "Switzerland"
  },
  "category": "urban",
  "positioning": "Grand hotel on the shores of Lake Geneva in Lausanne, opened in 1861, with a 1,500-square-metre Guerlain Spa",
  "best_for": [
    "Travelers who want a lakeside base in Lausanne",
    "Spa-focused stays, with heated indoor and outdoor pools",
    "Couples looking at suites with lake-view balconies or terraces"
  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel sits on the shores of Lake Geneva in Lausanne.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-2",
      "text": "The hotel has four restaurants and two bars.",
      "source_ids": [
        "s2"
      ]
    },
    {
      "id": "f-3",
      "text": "Kaigan serves Japanese cuisine made with authentic Japanese techniques, from sushi to teppanyaki, with sake.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-4",
      "text": "Café Beau-Rivage serves brasserie classics and has an outdoor terrace looking onto the lake.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-5",
      "text": "La Terrasse serves a breakfast buffet with views of Lake Geneva.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-6",
      "text": "The Guerlain Spa has heated indoor and outdoor pools.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-7",
      "text": "The spa's changing areas include a hammam, sauna, ice cave and ice fountain.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-8",
      "text": "Guerlain created an exclusive Beau-Rivage Palace fragrance for the hotel.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "f-9",
      "text": "Palace Junior Suites open onto balconies at the front of the hotel, with views of Lake Geneva.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-10",
      "text": "The Spa Suite has its own private Guerlain spa with a hammam, steam shower and hot tub.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-11",
      "text": "The Panoramic Suite has a roof terrace with views of Ouchy, the lakefront and the Alps.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "f-12",
      "text": "In 2026 the hotel received a score of 100/100 in the Falstaff Hotel Guide.",
      "source_ids": [
        "s7"
      ],
      "expires": "2027-12-31"
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "Beau-Rivage Palace opened in 1861 as a grand hotel on the Quais d'Ouchy in Lausanne.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "h-2",
      "text": "The Guerlain Spa covers 1,500 square metres.",
      "source_ids": [
        "s6"
      ]
    },
    {
      "id": "h-3",
      "text": "The Imperial Suite has one of the largest private hotel terraces in Switzerland.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-4",
      "text": "La Rotonde, a dome, connects the two halves of the building.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "h-5",
      "text": "The spa's private Suite Orchidée Impériale has a Japanese bath for two and a private hammam.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "The hotel is a 45-minute drive from Geneva International Airport.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "c-2",
      "text": "Sister properties Hôtel Angleterre and Château d'Ouchy, a short walk away, have their own restaurants; those venues are not inside Beau-Rivage Palace.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes the formal atmosphere may not suit casual travelers.",
      "source_ids": [
        "s1"
      ]
    }
  ],
