  ],
  "facts": [
    {
      "id": "f-1",
      "text": "The hotel is a beachfront resort in the Hotel Zone of Cancun.",
      "source_ids": [
        "s2",
        "s5"
      ]
    },
    {
      "id": "f-2",
      "text": "The thatched beach villas accommodate up to four adults.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "f-3",
      "text": "The Club Lounge is on the eighth floor and is for guests staying in Club rooms and suites.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "f-4",
      "text": "The tennis courts are beside the lagoon and are available to all hotel guests, booked through the concierge team.",
      "source_ids": [
        "s7"
      ]
    },
    {
      "id": "f-5",
      "text": "Instructors teach beginners the rules of pickleball.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-6",
      "text": "The hotel has a spa, a fitness center and a kids' club.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "f-7",
      "text": "Boutique Narita, inside the hotel, sells international fashion, including the Camilla and La Perla boutiques.",
      "source_ids": [
        "s5"
      ]
    },
    {
      "id": "f-8",
      "text": "The concierge team can secure show seats and make restaurant reservations.",
      "source_ids": [
        "s11"
      ]
    },
    {
      "id": "f-9",
      "text": "The hotel operates a non-smoking policy.",
      "source_ids": [
        "s2"
      ]
    }
  ],
  "highlights": [
    {
      "id": "h-1",
      "text": "The hotel has two temperature-controlled outdoor pools, a seafront hot tub and access to the Caribbean Sea.",
      "source_ids": [
        "s4"
      ]
    },
    {
      "id": "h-2",
      "text": "Thatched-roof beach villas can be reserved on the beach at an additional cost.",
      "source_ids": [
        "s3"
      ]
    },
    {
      "id": "h-3",
      "text": "The Club Lounge looks over the sunset on Nichupte Lagoon.",
      "source_ids": [
        "s9"
      ]
    },
    {
      "id": "h-4",
      "text": "The hotel has pickleball courts with official measurements and lighting.",
      "source_ids": [
        "s10"
      ]
    },
    {
      "id": "h-5",
      "text": "A host known as the Lady in Red, dressed in red, welcomes each guest and gives personalized assistance and local knowledge.",
      "source_ids": [
        "s6"
      ]
    }
  ],
  "considerations": [
    {
      "id": "c-1",
      "text": "Companion dogs up to 15 kg (33 lb) are admitted under the Kempinski Paws program.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-2",
      "text": "A dog's stay under Kempinski Paws needs prior confirmation by the hotel and is subject to availability.",
      "source_ids": [
        "s8"
      ]
    },
    {
      "id": "c-3",
      "text": "WhataHotel notes the Hotel Zone location is busy with tourist crowds.",
      "source_ids": [
        "s1"
      ]
    }
